          "401": {
            "description": "Invalid bearer key"
          },
          "503": {
            "description": "Integration not configured"
          }
        }
      }
    },
    "/products/{id}": {
      "get": {
        "summary": "Get published products detail",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "locale",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "tr",
                "en",
                "de"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Full content",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContentItem"
                }
              }
            }
          },
          "400": {
            "description": "Invalid query/id"
          },
          "401": {
            "description": "Invalid bearer key"
          },
          "404": {
            "description": "Published translation not found"
          },
          "503": {
            "description": "Integration not configured"
          }
        }
      }
    },
    "/pages": {
      "get": {
        "summary": "List published pages",
        "parameters": [
          {
            "name": "locale",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "tr",
                "en",
                "de"
              ]
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 60,
              "default": 24
            }
          },
          {
            "name": "offset",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000,
