            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "recent",
                "popular"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated content",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContentPage"
                }
              }
            }
          },
          "400": {
            "description": "Invalid query"
          },
          "401": {
            "description": "Invalid bearer key"
          },
          "503": {
            "description": "Integration not configured"
          }
        }
      }
    },
    "/pages/{id}": {
      "get": {
        "summary": "Get published pages detail",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "locale",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "tr",
                "en",
                "de"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Full content",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContentItem"
                }
              }
            }
          },
          "400": {
            "description": "Invalid query/id"
          },
          "401": {
            "description": "Invalid bearer key"
          },
          "404": {
            "description": "Published translation not found"
          },
          "503": {
            "description": "Integration not configured"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "SiteBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "ContentItem": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "locale",
          "title",
          "url",
          "contentHtml"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "kind": {
            "type": "string",
            "enum": [
              "article",
              "product"
            ]
          },
          "contentType": {
            "type": "string"
          },
          "locale": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "imageUrl": {
            "type": "string",
            "nullable": true
          },
          "image_url": {
            "type": "string",
            "nullable": true
          },
          "imageUrls": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uri"
            }
          },
          "excerpt": {
            "type": "string",
            "nullable": true
          },
          "contentHtml": {
            "type": "string"
          },
          "publishedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true,
            "description": "Source creation timestamp, not an exact publication transition timestamp."
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "price": {
            "type": "number",
            "nullable": true
          },
          "popularity": {
            "type": "number",
            "nullable": true
          }
        }
      },
      "ContentPage": {
        "type": "object",
        "required": [
          "contract",
          "items",
          "total",
          "limit",
          "offset",
          "hasMore"
        ],
        "properties": {
          "contract": {
            "type": "string"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ContentItem"
            }
          },
          "total": {
            "type": "integer"
          },
          "limit": {
            "type": "integer"
          },
          "offset": {
            "type": "integer"
          },
          "hasMore": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
